rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validImage() {
      return request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Logo o portada de cada comunidad.
    match /communities/{communityId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() || (signedIn() && validImage());
    }

    // Avatar del usuario.
    match /users/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth.uid == uid && validImage();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
